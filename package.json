{
  "name": "reseumer",
  "version": "0.7.1",
  "description": "AI-powered resume builder (Tauri desktop)",
  "author": "liuchen",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "pnpm build:export-css && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:win": "tauri build --target x86_64-pc-windows-msvc",
    "build:mac": "tauri build --target aarch64-apple-darwin",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "for file in scripts/test-*.ts; do tsx \"$file\" || exit 1; done",
    "test:date": "pnpm test",
    "test:ui": "node scripts/tauri-mock/test-ui.mjs",
    "build:export-css": "tsx scripts/build-export-css.ts",
    "check:design": "node scripts/check-design-contract.mjs"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
